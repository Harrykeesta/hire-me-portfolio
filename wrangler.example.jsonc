// Cloudflare Workers, static assets only: free, no server code to run.
// Copy to wrangler.jsonc (ignored by git) and set your own name and domain.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true
  // After your domain is on Cloudflare, uncomment and set it, then `npm run deploy`:
  // ,"routes": [
  //   { "pattern": "yourname.com", "custom_domain": true },
  //   { "pattern": "www.yourname.com", "custom_domain": true }
  // ]
}
